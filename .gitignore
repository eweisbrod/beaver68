# =============================================================================
# Polyglot .gitignore — R + Python + Stata
# Shared across project-template-r and project-template so users can
# mix languages freely regardless of which template they start from.
# =============================================================================


# === R ========================================================================

# Session and history
.Rhistory
.Rapp.history
.RData
.RDataTmp
.Ruserdata
.Renviron

# RStudio
.Rproj.user/
*.Rproj
rsconnect/

# ...but DO ship this project's own .Rproj. Students are told to open it,
# and it is what sets the working directory to the repo root so the
# scripts' relative paths (src/utils.R, .env) resolve correctly.
!beaver68.Rproj

# VS Code / Cursor / Positron (editor-specific config, kept user-local)
.vscode/

# Package build artifacts
*-Ex.R
/*.tar.gz
/*.Rcheck/

# Vignettes / R Markdown / knitr
vignettes/*.html
vignettes/*.pdf
*_cache/
/cache/
*.utf8.md
*.knit.md
/*_files/
/files/
/src/*_files/

# OAuth token
.httr-oauth

# pkgdown
docs/

# Translation temp files
po/*~


# === Python ===================================================================

# Virtual environments (uv, venv, virtualenv)
.venv/
venv/
ENV/

# Byte-compiled / cached
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Distribution / packaging
*.egg-info/
*.egg
dist/
build/

# Jupyter
.ipynb_checkpoints/

# mypy / type checkers
.mypy_cache/
.ruff_cache/


# === Stata ====================================================================

# Stata temp/log files
*.smcl
*.sthlp


# === Shared / project-level ==================================================

# Environment files (credentials, local paths — never commit)
.env

# Claude Code local settings
.claude/

# Output files (generated by scripts — keep directory via .gitkeep)
output/*
!output/.gitkeep
/out/*

# Common generated file types
*.html
*.pdf
*.aux
*.rda

# Log files from run-all.R
log/

# Data files (large, stored outside repo per .env DATA_DIR)
*.parquet
*.dta
*.sas7bdat
*.csv

# The provenance/ folder itself (and its README.md) IS tracked, but the
# sample-identifier data files inside it are NOT. They get generated by
# 005-data-provenance on every run and are specific to whoever ran the
# pipeline. Submitters preparing a JAR replication package should
# explicitly force-add the files they want to ship:
#   git add -f provenance/sample-identifiers.csv
# The template stays clean by default so it can be passed around without
# carrying a stray sample-id file from whoever last ran the pipeline.

# macOS
.DS_Store
